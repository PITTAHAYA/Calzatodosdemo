# =========================================================================
# Variables de entorno de Calzatodos Group
# Copia este archivo como ".env.local" y completa los valores reales.
# NUNCA subas ".env.local" al repositorio.
# =========================================================================

# URL pública del sitio (usada para SEO, canonical, sitemap y Open Graph).
NEXT_PUBLIC_SITE_URL="https://www.calzatodos.com"

# --- Envío de formularios por correo (contacto y mayoristas) ---
# El sitio usa un proveedor SMTP configurable mediante variables de entorno.
# Recomendado: una cuenta SMTP transaccional (Resend, Brevo, Zoho, Gmail App
# Password, etc.). Estas claves SOLO se leen en el servidor.
SMTP_HOST="smtp.tu-proveedor.com"
SMTP_PORT="587"
SMTP_USER="usuario@tu-dominio.com"
SMTP_PASSWORD="tu-contraseña-o-app-password"
SMTP_FROM="Calzatodos Group <no-reply@tu-dominio.com>"

# Correo(s) que recibirán las solicitudes del sitio.
CONTACT_TO_EMAIL="calzatodos@hotmail.com"
WHOLESALE_TO_EMAIL="calzatodos@hotmail.com"

# Alternativa: si defines RESEND_API_KEY, el sitio usará Resend en lugar de SMTP.
# RESEND_API_KEY=""

# Si NINGUNA variable de correo está configurada, los formularios funcionan en
# "modo demostración": validan y registran la solicitud en la consola del
# servidor sin enviar correo. Ideal para desarrollo local.

# =========================================================================
# Panel de administración (/admin)
# =========================================================================
# Usuario del panel.
ADMIN_USER="admin"
# Hash de la contraseña generado con:  node scripts/hash-password.mjs "tuClave"
# Formato:  pbkdf2$<iter>$<saltB64>$<hashB64>
# IMPORTANTE si usas un archivo .env/.env.local (no el dashboard de Vercel):
# Next.js interpreta "$" como inicio de una variable a expandir. Escápalo
# como "\$" en este archivo o el hash quedará corrupto y el login fallará.
# El script hash-password.mjs ya te da la versión escapada lista para pegar.
ADMIN_PASSWORD_HASH=""
# Cadena aleatoria larga (mín. 32 chars) para firmar la cookie de sesión.
# Puedes generarla con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=""

# --- Almacenamiento del catálogo editado (recomendado en Vercel) -----------
# Si defines estas variables, el panel usa Vercel KV para los datos
# (patches/borrados/creados). En dev/VPS sin estas variables, guarda en
# data/products-overrides.json.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# --- Almacenamiento de fotos subidas desde /admin (recomendado en Vercel) --
# Si defines BLOB_READ_WRITE_TOKEN, las fotos van a Vercel Blob.
# En dev/VPS sin esta variable, se guardan en /public/uploads/products.
# Ambos servicios se activan en el dashboard de Vercel > Storage; al
# conectar la integración, las variables aparecen automáticamente.
BLOB_READ_WRITE_TOKEN=""
